<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">

  <title>
    {{ page_title }}
    {%- if current_tags -%} &ndash; tagged "{{ current_tags | join: ', ' }}"{%- endif -%}
    {%- if current_page != 1 -%} &ndash; Page {{ current_page }}{%- endif -%}
    {%- unless page_title contains shop.name -%} &ndash; {{ shop.name }}{%- endunless -%}
  </title>

  {%- render 'meta-tags' -%}

  {{ content_for_header }}

  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js','js');</script>

  {%- if settings.custom_head_code != blank -%}
    {{ settings.custom_head_code }}
  {%- endif -%}
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.suffix }}{% endif %}">

  <a class="skip-to-content-link btn btn-primary" href="#MainContent">Skip to content</a>

  {%- section 'announcement-bar' -%}
  {%- section 'header' -%}

  {%- render 'mobile-nav' -%}
  {%- render 'cart-drawer' -%}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}

  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>

  {%- if settings.custom_footer_code != blank -%}
    {{ settings.custom_footer_code }}
  {%- endif -%}

</body>
</html>
