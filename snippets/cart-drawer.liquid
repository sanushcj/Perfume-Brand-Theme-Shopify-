<div class="cart-drawer-overlay" id="CartDrawerOverlay" data-cart-close></div>

<div class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-label="Shopping Bag">

  <div class="cart-drawer-header">
    <div class="cart-drawer-header-left">
      <h2 class="cart-drawer-title">Shopping Bag</h2>
      <span class="cart-drawer-count" id="CartDrawerCount">({{ cart.item_count }})</span>
    </div>
    <button type="button" class="cart-drawer-close" data-cart-close aria-label="Close shopping bag">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  {%- comment -%} Free Shipping Progress Bar {%- endcomment -%}
  {%- assign free_ship_val = settings.free_shipping_threshold | default: 100 -%}
  {%- if free_ship_val > 0 -%}
    {%- assign threshold_cents = free_ship_val | times: 100 -%}
    <div class="cart-shipping-bar" id="CartShippingBar" data-threshold="{{ threshold_cents }}">
      {%- if cart.total_price >= threshold_cents -%}
        <p class="shipping-bar-text">✨ {{ settings.free_shipping_message | default: 'You qualify for complimentary fragrance delivery!' }}</p>
        <div class="shipping-bar-progress-container">
          <div class="shipping-bar-progress" style="width: 100%;"></div>
        </div>
      {%- else -%}
        {%- assign remaining_cents = threshold_cents | minus: cart.total_price -%}
        <p class="shipping-bar-text">Add <strong>{{ remaining_cents | money }}</strong> more to unlock <strong>Complimentary Delivery</strong></p>
        {%- assign progress = cart.total_price | times: 100 | divided_by: threshold_cents -%}
        <div class="shipping-bar-progress-container">
          <div class="shipping-bar-progress" style="width: {{ progress }}%;"></div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="cart-drawer-body" id="CartDrawerBody">
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer-empty" id="CartDrawerEmpty">
        <div class="cart-drawer-empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
        </div>
        <p class="cart-empty-title">Your shopping bag is empty</p>
        <p class="cart-empty-sub">Explore our Signature and Discovery collections to discover your distinctive fragrance.</p>
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="btn btn-primary btn-sm" data-cart-close>
          Explore Fragrances
        </a>
      </div>
    {%- else -%}
      <div class="cart-drawer-items-list" id="CartDrawerItemsList">
        {%- for item in cart.items -%}
          <div class="cart-drawer-item" data-line-key="{{ item.key }}" data-line-index="{{ forloop.index }}">
            <a href="{{ item.url }}" class="cart-drawer-item-img-link">
              {%- if item.image -%}
                <img
                  src="{{ item.image | image_url: width: 180 }}"
                  alt="{{ item.product.title | escape }}"
                  class="cart-drawer-item-image"
                  loading="lazy"
                  width="80"
                  height="100"
                >
              {%- else -%}
                <div class="cart-item-placeholder">✦</div>
              {%- endif -%}
            </a>

            <div class="cart-drawer-item-info">
              <div class="cart-drawer-item-top">
                <a href="{{ item.url }}" class="cart-drawer-item-name">{{ item.product.title }}</a>
                <button
                  type="button"
                  class="cart-item-remove-btn"
                  data-line-key="{{ item.key }}"
                  aria-label="Remove {{ item.product.title | escape }}"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6L6 18M6 6l12 12"/>
                  </svg>
                </button>
              </div>

              {%- unless item.variant.title == 'Default Title' or item.variant.title == blank -%}
                <div class="cart-drawer-item-variant">{{ item.variant.title }}</div>
              {%- endunless -%}

              <div class="cart-drawer-item-bottom">
                <div class="quantity-selector cart-qty-selector">
                  <button
                    type="button"
                    class="qty-btn"
                    data-action="decrease"
                    data-line-key="{{ item.key }}"
                    data-qty="{{ item.quantity }}"
                    aria-label="Decrease quantity"
                  >−</button>
                  <span class="qty-display">{{ item.quantity }}</span>
                  <button
                    type="button"
                    class="qty-btn"
                    data-action="increase"
                    data-line-key="{{ item.key }}"
                    data-qty="{{ item.quantity }}"
                    aria-label="Increase quantity"
                  >+</button>
                </div>

                <div class="cart-drawer-item-price">
                  {{ item.final_line_price | money }}
                </div>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="cart-drawer-footer" id="CartDrawerFooter" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
    {%- if settings.show_cart_notes -%}
      <details class="cart-notes-toggle">
        <summary class="cart-notes-summary">
          <span>Add a Gift Message or Order Note</span>
          <span class="accordion-arrow">▼</span>
        </summary>
        <textarea
          name="note"
          id="CartDrawerNote"
          class="cart-note-input"
          placeholder="Special instructions or gift card message..."
          rows="2"
        >{{ cart.note }}</textarea>
      </details>
    {%- endif -%}

    <div class="cart-drawer-total-row">
      <span class="cart-drawer-total-label">Subtotal</span>
      <span class="cart-drawer-total-value" id="CartDrawerTotal">{{ cart.total_price | money }}</span>
    </div>

    <p class="cart-drawer-shipping-note">Taxes and regional delivery calculated at checkout</p>

    <div class="cart-drawer-actions">
      <a href="{{ routes.checkout_url }}" class="btn btn-primary btn-full btn-lg cart-checkout-btn" id="CartDrawerCheckoutBtn">
        <span>Proceed to Checkout</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>

      <div class="cart-secondary-actions">
        <a href="{{ routes.cart_url }}" class="cart-view-page-link">View Full Cart</a>
        <button type="button" class="cart-continue-btn" data-cart-close>Continue Browsing</button>
      </div>
    </div>

    <div class="cart-drawer-security">
      <span>🔒 Official Shopify Secure Checkout</span>
    </div>
  </div>

</div>
