<div class="cart-drawer-overlay" id="CartDrawerOverlay"></div>

<div class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-label="Shopping cart">

  <div class="cart-drawer-header">
    <h2 class="cart-drawer-title">Your Cart</h2>
    <button class="nav-action-btn" data-cart-close aria-label="Close cart">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="cart-drawer-body" id="CartDrawerBody">
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer-empty">
        <div class="cart-drawer-empty-icon">🛒</div>
        <p style="font-size: var(--text-base); font-weight: var(--fw-medium); color: var(--color-text-secondary);">Your cart is empty</p>
        <p style="font-size: var(--text-sm); color: var(--color-text-muted);">Add some fragrances to get started</p>
        <a href="{{ routes.collections_url }}/all" class="btn btn-outline btn-sm" data-cart-close>Explore Collection</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-drawer-item" data-variant-id="{{ item.variant_id }}">
          <a href="{{ item.url }}">
            {%- if item.image -%}
              <img
                src="{{ item.image | image_url: width: 200 }}"
                alt="{{ item.product.title | escape }}"
                class="cart-drawer-item-image"
                loading="lazy"
                width="80"
                height="96"
              >
            {%- else -%}
              <div class="cart-drawer-item-image" style="background: var(--color-bg-card); display:flex; align-items:center; justify-content:center; color: var(--color-text-muted); font-size: 24px;">🌸</div>
            {%- endif -%}
          </a>
          <div class="cart-drawer-item-info">
            <a href="{{ item.url }}" class="cart-drawer-item-name">{{ item.product.title }}</a>
            {%- unless item.variant.title == 'Default Title' -%}
              <div class="cart-drawer-item-variant">{{ item.variant.title }}</div>
            {%- endunless -%}
            <div class="cart-drawer-item-bottom">
              <div class="quantity-selector" style="transform: scale(0.85); transform-origin: left;">
                <button class="qty-btn" data-action="decrease" data-variant="{{ item.variant_id }}" data-qty="{{ item.quantity }}" aria-label="Decrease quantity">−</button>
                <span style="padding: 0 var(--space-2); font-size: var(--text-sm); color: var(--color-text-primary); min-width: 20px; text-align: center;">{{ item.quantity }}</span>
                <button class="qty-btn" data-action="increase" data-variant="{{ item.variant_id }}" data-qty="{{ item.quantity }}" aria-label="Increase quantity">+</button>
              </div>
              <div class="cart-drawer-item-price">{{ item.final_line_price | money }}</div>
            </div>
            <button class="cart-item-remove" data-variant="{{ item.variant_id }}" style="font-size:11px; margin-top: 6px;" aria-label="Remove {{ item.product.title }} from cart">Remove</button>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <div class="cart-drawer-footer">
      <div class="cart-drawer-total">
        <span class="cart-drawer-total-label">Subtotal</span>
        <span class="cart-drawer-total-value" id="CartDrawerTotal">{{ cart.total_price | money }}</span>
      </div>
      <p style="font-size: var(--text-xs); color: var(--color-text-muted); text-align:center; margin-bottom: var(--space-3);">Shipping & taxes calculated at checkout</p>
      <a href="{{ routes.checkout_url }}" class="btn btn-primary btn-full cart-checkout-btn" id="CartCheckoutBtn">
        Checkout
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="btn btn-ghost btn-full btn-sm" data-cart-close>View Full Cart</a>
    </div>
  {%- endif -%}

</div>
