<div class="cart-drawer-overlay" id="CartDrawerOverlay"></div>

<div class="cart-drawer" id="CartDrawer" role="dialog" aria-modal="true" aria-label="Shopping bag">

  <div class="cart-drawer-header">
    <div class="cart-drawer-header-left">
      <h2 class="cart-drawer-title">Shopping Bag</h2>
      <span class="cart-drawer-count" id="CartDrawerCount">({{ cart.item_count }})</span>
    </div>
    <button class="cart-drawer-close" data-cart-close aria-label="Close cart">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  {%- comment -%} Free Shipping Progress Bar {%- endcomment -%}
  {%- assign threshold = settings.free_shipping_threshold | default: 100 | times: 100 -%}
  <div class="cart-shipping-bar" id="CartShippingBar" data-threshold="{{ threshold }}">
    {%- if cart.total_price >= threshold -%}
      <p class="shipping-bar-text">✨ {{ settings.free_shipping_message | default: 'You qualify for Free Worldwide Express Delivery!' }}</p>
      <div class="shipping-bar-progress-container"><div class="shipping-bar-progress" style="width: 100%;"></div></div>
    {%- else -%}
      {%- assign remaining = threshold | minus: cart.total_price -%}
      <p class="shipping-bar-text">Add <strong>{{ remaining | money }}</strong> more to unlock <strong>Free Express Delivery</strong></p>
      {%- assign progress = cart.total_price | times: 100 | divided_by: threshold -%}
      <div class="shipping-bar-progress-container"><div class="shipping-bar-progress" style="width: {{ progress }}%;"></div></div>
    {%- endif -%}
  </div>

  <div class="cart-drawer-body" id="CartDrawerBody">
    {%- if cart.item_count == 0 -%}
      <div class="cart-drawer-empty" id="CartDrawerEmpty">
        <div class="cart-drawer-empty-icon">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
        </div>
        <p class="cart-empty-title">Your shopping bag is empty</p>
        <p class="cart-empty-sub">Discover our signature fragrances and elevate your scent presence.</p>
        <a href="{{ routes.collections_url }}" class="btn btn-primary btn-sm" data-cart-close>Explore Fragrances</a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-drawer-item" data-variant-id="{{ item.variant_id }}">
          <a href="{{ item.url }}" class="cart-drawer-item-img-link">
            {%- if item.image -%}
              <img
                src="{{ item.image | image_url: width: 200 }}"
                alt="{{ item.product.title | escape }}"
                class="cart-drawer-item-image"
                loading="lazy"
                width="80"
                height="80"
              >
            {%- else -%}
              <img
                src="{{ 'product-santal-blanc.jpg' | asset_url }}"
                alt="{{ item.product.title | escape }}"
                class="cart-drawer-item-image"
                loading="lazy"
                width="80"
                height="80"
              >
            {%- endif -%}
          </a>
          <div class="cart-drawer-item-info">
            <div class="cart-drawer-item-top">
              <a href="{{ item.url }}" class="cart-drawer-item-name">{{ item.product.title }}</a>
              <button class="cart-item-remove" data-variant="{{ item.variant_id }}" aria-label="Remove {{ item.product.title }} from bag">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 6L6 18M6 6l12 12"/>
                </svg>
              </button>
            </div>
            {%- unless item.variant.title == 'Default Title' -%}
              <div class="cart-drawer-item-variant">{{ item.variant.title }}</div>
            {%- endunless -%}
            <div class="cart-drawer-item-bottom">
              <div class="quantity-selector cart-qty">
                <button type="button" class="qty-btn" data-action="decrease" data-variant="{{ item.variant_id }}" data-qty="{{ item.quantity }}" aria-label="Decrease quantity">−</button>
                <span class="qty-display">{{ item.quantity }}</span>
                <button type="button" class="qty-btn" data-action="increase" data-variant="{{ item.variant_id }}" data-qty="{{ item.quantity }}" aria-label="Increase quantity">+</button>
              </div>
              <div class="cart-drawer-item-price">{{ item.final_line_price | money }}</div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="cart-drawer-footer" id="CartDrawerFooter" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
    <div class="cart-drawer-total">
      <span class="cart-drawer-total-label">Subtotal</span>
      <span class="cart-drawer-total-value" id="CartDrawerTotal">{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer-note">Taxes and express shipping calculated at checkout</p>
    <a href="{{ routes.checkout_url }}" class="btn btn-primary btn-full cart-checkout-btn" id="CartCheckoutBtn">
      <span>Proceed to Checkout</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
    <div class="cart-drawer-trust">
      <span>🔒 256-Bit SSL Secure Checkout</span>
      <span>✦ 30-Day Guarantee</span>
    </div>
  </div>

</div>
