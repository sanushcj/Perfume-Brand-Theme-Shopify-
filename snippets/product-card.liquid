{%- comment -%}
  AD PERFUMES — Premium Reusable Product Card
  Accepts:
  - product_card_product: {Object} Shopify Product
  - show_vendor: {Boolean} Show perfume brand/vendor
  - show_quick_add: {Boolean} Show quick add action
  - dummy_index: {Number} Fallback index if no product assigned
{%- endcomment -%}

{%- assign p = product_card_product -%}
{%- assign current_variant = p.selected_or_first_available_variant -%}
{%- assign image_ratio = settings.product_card_image_ratio | default: 'portrait' -%}

{%- if p != blank -%}
  <article class="product-card" data-product-id="{{ p.id }}">
    <div class="product-card-media-wrapper product-card-ratio-{{ image_ratio }}">
      <a href="{{ p.url }}" class="product-card-visual" aria-label="{{ p.title | escape }}">

        {%- comment -%} Badges {%- endcomment -%}
        <div class="product-card-badges">
          {%- if p.available == false -%}
            <span class="product-badge badge-sold-out">Sold Out</span>
          {%- elsif p.compare_at_price > p.price and settings.show_sale_badge != false -%}
            {%- assign savings_percent = p.compare_at_price | minus: p.price | times: 100.0 | divided_by: p.compare_at_price | round -%}
            <span class="product-badge badge-sale">Sale {%- if savings_percent > 0 -%}&nbsp;{{ savings_percent }}% OFF{%- endif -%}</span>
          {%- endif -%}
        </div>

        {%- comment -%} Images with secondary hover {%- endcomment -%}
        {%- if p.featured_image -%}
          <img
            src="{{ p.featured_image | image_url: width: 600 }}"
            alt="{{ p.featured_image.alt | default: p.title | escape }}"
            class="product-card-img product-card-img-primary"
            loading="lazy"
            width="600"
            height="750"
          >
          {%- if settings.show_secondary_image_on_hover != false and p.images.size > 1 -%}
            <img
              src="{{ p.images[1] | image_url: width: 600 }}"
              alt="{{ p.images[1].alt | default: p.title | escape }}"
              class="product-card-img product-card-img-secondary"
              loading="lazy"
              width="600"
              height="750"
            >
          {%- endif -%}
        {%- else -%}
          <div class="product-card-placeholder">
            <span class="placeholder-icon">✦</span>
          </div>
        {%- endif -%}
      </a>

      {%- comment -%} Quick Action Button {%- endcomment -%}
      {%- if settings.enable_quick_add != false and show_quick_add != false -%}
        <div class="product-card-actions">
          {%- if p.available == false -%}
            <button type="button" class="btn btn-ghost btn-sm btn-full" disabled>
              Sold Out
            </button>
          {%- elsif p.has_only_default_variant or p.variants.size == 1 -%}
            <button
              type="button"
              class="btn btn-primary btn-sm btn-full quick-add-trigger"
              data-variant-id="{{ current_variant.id }}"
              data-product-title="{{ p.title | escape }}"
              data-product-price="{{ p.price | money }}"
              data-product-image="{{ p.featured_image | image_url: width: 160 }}"
              aria-label="Add {{ p.title | escape }} to shopping bag"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
                <line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 01-8 0"/>
              </svg>
              <span>Add to Bag</span>
            </button>
          {%- else -%}
            <a href="{{ p.url }}" class="btn btn-primary btn-sm btn-full" aria-label="Choose available sizes for {{ p.title | escape }}">
              <span>Choose Size</span>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-card-body">
      {%- if show_vendor or settings.show_vendor -%}
        <span class="product-card-vendor">{{ p.vendor }}</span>
      {%- elsif p.type != blank -%}
        <span class="product-card-category">{{ p.type }}</span>
      {%- endif -%}

      <h3 class="product-card-title">
        <a href="{{ p.url }}">{{ p.title }}</a>
      </h3>

      <div class="product-card-price-row">
        <div class="price-container">
          <span class="product-card-price">{{ p.price | money }}</span>
          {%- if p.compare_at_price > p.price and settings.show_compare_at_price != false -%}
            <s class="product-card-compare-price">{{ p.compare_at_price | money }}</s>
          {%- endif -%}
        </div>

        {%- if p.available -%}
          <span class="product-card-availability in-stock">Available</span>
        {%- else -%}
          <span class="product-card-availability out-of-stock">Sold Out</span>
        {%- endif -%}
      </div>
    </div>
  </article>

{%- else -%}
  {%- comment -%} Clean Onboarding Placeholder Card {%- endcomment -%}
  <article class="product-card product-card-placeholder-card">
    <div class="product-card-media-wrapper product-card-ratio-{{ image_ratio }}">
      <div class="product-card-visual" style="background: var(--color-bg-card); display: flex; align-items: center; justify-content: center;">
        {%- if dummy_index == 1 -%}
          <img src="{{ 'product-addicted.jpg' | asset_url }}" alt="ADDICTED" class="product-card-img" width="600" height="750" loading="lazy">
        {%- elsif dummy_index == 2 -%}
          <img src="{{ 'product-ice-of-heaven.jpg' | asset_url }}" alt="Ice of Heaven" class="product-card-img" width="600" height="750" loading="lazy">
        {%- elsif dummy_index == 3 -%}
          <img src="{{ 'product-rouge-elite.jpg' | asset_url }}" alt="Rouge Elite" class="product-card-img" width="600" height="750" loading="lazy">
        {%- else -%}
          <img src="{{ 'discovery-travel-set.jpg' | asset_url }}" alt="Discovery Fragrance" class="product-card-img" width="600" height="750" loading="lazy">
        {%- endif -%}
      </div>
    </div>
    <div class="product-card-body">
      <span class="product-card-category">
        {%- if dummy_index <= 3 -%}The Signature Collection (50ml){%- else -%}The Discovery Collection{%- endif -%}
      </span>
      <h3 class="product-card-title">
        {%- if dummy_index == 1 -%}ADDICTED — 50ml
        {%- elsif dummy_index == 2 -%}Ice of Heaven — 50ml
        {%- elsif dummy_index == 3 -%}Rouge Elite — 50ml
        {%- elsif dummy_index == 4 -%}Purple Mist — 10ml / 20ml
        {%- elsif dummy_index == 5 -%}Old Money — 10ml / 20ml
        {%- elsif dummy_index == 6 -%}Fallen Star — 10ml / 20ml
        {%- elsif dummy_index == 7 -%}Coffee — 10ml / 20ml
        {%- elsif dummy_index == 8 -%}Toxic — 10ml / 20ml
        {%- else -%}Dark Chocolates — 10ml / 20ml
        {%- endif -%}
      </h3>
      <div class="product-card-price-row">
        <span class="product-card-price" style="color: var(--color-text-muted); font-size: var(--text-xs);">Assign product in Shopify</span>
      </div>
    </div>
  </article>
{%- endif -%}
