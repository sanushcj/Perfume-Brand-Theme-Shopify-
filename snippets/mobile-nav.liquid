<nav class="mobile-nav" id="MobileNav" aria-label="Mobile navigation" aria-hidden="true">
  <div class="mobile-nav-backdrop" id="MobileNavBackdrop" data-mobile-nav-close></div>
  <div class="mobile-nav-panel" role="dialog" aria-modal="true" aria-label="Menu">

    <div class="mobile-nav-header">
      <a href="{{ routes.root_url }}" class="nav-logo" style="text-decoration:none;">
        <span class="nav-logo-name">{{ settings.brand_name | default: 'AD PERFUMES' }}</span>
        <span class="nav-logo-tagline">{{ settings.brand_tagline | default: 'Your Fragrance. Your Vision. Your Brand.' }}</span>
      </a>
      <button class="mobile-nav-close" id="MobileNavClose" aria-label="Close menu" data-mobile-nav-close>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="mobile-nav-links">
      {%- assign mobile_menu = 'main-menu' -%}
      {%- if linklists[mobile_menu].links.size > 0 -%}
        {%- for link in linklists[mobile_menu].links -%}
          <a
            href="{{ link.url }}"
            class="mobile-nav-link{% if link.active %} active{% endif %}"
          >
            <span>{{ link.title }}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        {%- endfor -%}
      {%- else -%}
        <a href="{{ routes.root_url }}" class="mobile-nav-link">
          <span>Home</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="mobile-nav-link">
          <span>All Fragrances</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="{{ routes.search_url }}" class="mobile-nav-link">
          <span>Search</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/pages/contact" class="mobile-nav-link">
          <span>Contact Concierge</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="mobile-nav-footer">
      <div class="mobile-contact-card">
        <p class="mobile-contact-title">Client Support</p>
        <a href="tel:+918921362927" class="mobile-contact-line">
          <span>📞</span> +91 89213 62927
        </a>
        <a href="mailto:Connect.adperfumes@gmail.com" class="mobile-contact-line">
          <span>📧</span> Connect.adperfumes@gmail.com
        </a>
        <p class="mobile-contact-regions">
          <span>📍</span> Serving Kerala, Karnataka & UAE
        </p>
      </div>

      <div class="social-links" style="margin-top: var(--space-4);">
        <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/ad_.perfumes' }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
      </div>

      <p class="mobile-nav-copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'AD PERFUMES' }}. All rights reserved.
      </p>
    </div>

  </div>
</nav>
