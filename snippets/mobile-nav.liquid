<nav class="mobile-nav" id="MobileNav" aria-label="Mobile navigation" aria-hidden="true">
  <div class="mobile-nav-backdrop" id="MobileNavBackdrop"></div>
  <div class="mobile-nav-panel" role="dialog" aria-modal="true">

    <div class="mobile-nav-header">
      <a href="{{ routes.root_url }}" class="nav-logo" style="text-decoration:none;">
        <span class="nav-logo-name">{{ settings.brand_name | default: shop.name }}</span>
        <span class="nav-logo-tagline">{{ settings.brand_tagline | default: 'Haute Parfumerie' }}</span>
      </a>
      <button class="mobile-nav-close" id="MobileNavClose" aria-label="Close menu">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="mobile-nav-links">
      {%- for link in linklists['main-menu'].links -%}
        <a
          href="{{ link.url }}"
          class="mobile-nav-link{% if link.active %} active{% endif %}"
          {% if link.active %}style="color: var(--color-gold);"{% endif %}
        >
          {{ link.title }}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="mobile-nav-link">Home <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="{{ routes.collections_url }}/all" class="mobile-nav-link">Shop All <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="{{ routes.collections_url }}/flagship" class="mobile-nav-link">Flagship <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="{{ pages['about'].url }}" class="mobile-nav-link">About <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <a href="{{ pages['contact'].url }}" class="mobile-nav-link">Contact <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
      {%- endfor -%}
    </div>

    <div class="mobile-nav-footer">
      <div class="social-links">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_twitter_link != blank -%}
          <a href="{{ settings.social_twitter_link }}" class="social-link" aria-label="Twitter / X" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        {%- endif -%}
      </div>
      <p style="font-size: var(--text-xs); color: var(--color-text-muted); margin-top: var(--space-4);">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>
    </div>

  </div>
</nav>
