{%- if section.settings.show_announcement -%}
  <aside
    class="announcement-bar"
    role="status"
    aria-live="polite"
    style="background-color: {{ section.settings.bg_color | default: 'var(--color-bg-dark)' }}; color: {{ section.settings.text_color | default: 'var(--color-gold)' }};"
  >
    <div class="container announcement-bar-container">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-link" style="color: inherit; text-decoration: none;">
          <span>{{ section.settings.text }}</span>
        </a>
      {%- else -%}
        <span>{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement Text",
      "default": "AD PERFUMES • Luxury Fragrances • Serving Kerala, Karnataka & UAE"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement Link (Optional)"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#0E0E10"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text & Gold Accent Color",
      "default": "#C5A059"
    }
  ]
}
{% endschema %}
