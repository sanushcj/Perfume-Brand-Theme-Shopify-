<header class="site-header{% if section.settings.sticky_header %} sticky-header{% endif %}" id="SiteHeader" role="banner">
  <div class="container nav-container">
    <nav class="nav-inner" aria-label="Main Navigation">

      {%- comment -%} Mobile Hamburger Button {%- endcomment -%}
      <button class="hamburger" id="HamburgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="MobileNav">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>

      {%- comment -%} Brand Logo {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name }} - Home">
        {%- if section.settings.logo != blank -%}
          <img
            src="{{ section.settings.logo | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_max_width | default: 130 }}"
            height="auto"
            loading="eager"
            style="max-width: {{ section.settings.logo_max_width | default: 130 }}px; height: auto;"
          >
        {%- elsif settings.brand_logo != blank -%}
          <img
            src="{{ settings.brand_logo | image_url: width: 300 }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo_width | default: 130 }}"
            height="auto"
            loading="eager"
            style="max-width: {{ settings.logo_width | default: 130 }}px; height: auto;"
          >
        {%- else -%}
          <span class="nav-logo-name">{{ section.settings.brand_name | default: settings.brand_name | default: shop.name }}</span>
          <span class="nav-logo-tagline">{{ section.settings.brand_tagline | default: settings.brand_tagline | default: 'Your Fragrance. Your Vision. Your Brand.' }}</span>
        {%- endif -%}
      </a>

      {%- comment -%} Desktop Navigation Links {%- endcomment -%}
      <div class="nav-links" role="navigation">
        {%- assign header_menu = section.settings.menu | default: 'main-menu' -%}
        {%- if linklists[header_menu].links.size > 0 -%}
          {%- for link in linklists[header_menu].links -%}
            <a
              href="{{ link.url }}"
              class="nav-link{% if link.active %} active{% endif %}"
              {% if link.active %}aria-current="page"{% endif %}
            >
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="{{ routes.root_url }}" class="nav-link">Home</a>
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="nav-link">All Fragrances</a>
          <a href="{{ routes.search_url }}" class="nav-link">Search</a>
          <a href="/pages/contact" class="nav-link">Contact</a>
        {%- endif -%}
      </div>

      {%- comment -%} Header Actions {%- endcomment -%}
      <div class="nav-actions">
        {%- if section.settings.show_search != false -%}
          <button type="button" class="nav-action-btn" aria-label="Search Fragrances" data-search-toggle>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"/>
              <path d="M21 21l-4.35-4.35"/>
            </svg>
          </button>
        {%- endif -%}

        {%- if shop.customer_accounts_enabled and section.settings.show_account != false -%}
          <a href="{{ routes.account_url }}" class="nav-action-btn" aria-label="My Account">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </a>
        {%- endif -%}

        <button
          type="button"
          class="nav-action-btn nav-cart-btn"
          aria-label="Shopping Bag ({{ cart.item_count }} items)"
          data-cart-open
          id="HeaderCartBtn"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 01-8 0"/>
          </svg>
          <span class="cart-count{% if cart.item_count > 0 %} visible{% endif %}" id="HeaderCartCount" aria-live="polite">
            {{ cart.item_count }}
          </span>
        </button>
      </div>

    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_max_width",
      "label": "Custom Logo Width (px)",
      "min": 60,
      "max": 300,
      "step": 10,
      "default": 130
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name (if no logo uploaded)",
      "default": "AD PERFUMES"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Your Fragrance. Your Vision. Your Brand."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky Header on Scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Link",
      "default": true
    }
  ]
}
{% endschema %}
