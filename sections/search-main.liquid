<div class="search-page" data-section-id="{{ section.id }}" data-section-type="search">
  <div class="container">

    <div class="search-page-header text-center">
      <p class="section-eyebrow justify-center">Fragrance Discovery</p>
      <h1 class="section-title">Search Fragrances</h1>
    </div>

    <form class="search-form" action="{{ routes.search_url }}" method="get" role="search" aria-label="Search AD PERFUMES">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <div class="search-input-group">
        <label for="SearchPageInput" class="visually-hidden">Search</label>
        <input
          type="search"
          name="q"
          id="SearchPageInput"
          class="search-input"
          placeholder="Search by perfume name or notes (e.g. Saffron, Amber, Oud)..."
          value="{{ search.terms | escape }}"
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <button type="submit" class="btn btn-primary search-submit-btn" aria-label="Submit search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8"/>
            <path d="M21 21l-4.35-4.35"/>
          </svg>
          <span>Search</span>
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      <div class="search-results-summary text-center">
        {%- if search.results_count == 0 -%}
          <p class="search-summary-text">No fragrance results found for <strong class="search-term-highlight">"{{ search.terms }}"</strong></p>
        {%- else -%}
          <p class="search-summary-text">
            {{ search.results_count }} {%- if search.results_count == 1 -%}fragrance result{%- else -%}fragrance results{%- endif -%} for <strong class="search-term-highlight">"{{ search.terms }}"</strong>
          </p>
        {%- endif -%}
      </div>

      {%- paginate search.results by 24 -%}
        {%- if search.results.size > 0 -%}
          <div class="product-grid" id="SearchResultsGrid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                <div class="reveal">
                  {%- render 'product-card', product_card_product: item -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination-nav" aria-label="Search Pagination">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="btn btn-outline btn-sm">← Previous</a>
              {%- endif -%}

              <div class="pagination-pages">
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="pagination-page-link">{{ part.title }}</a>
                  {%- else -%}
                    <span class="pagination-page-current">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </div>

              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="btn btn-outline btn-sm">Next →</a>
              {%- endif -%}
            </nav>
          {%- endif -%}

        {%- else -%}
          <div class="search-empty text-center">
            <div class="empty-icon">✦</div>
            <h2 class="empty-title">Refine Your Fragrance Search</h2>
            <p class="empty-desc">
              We couldn't find matching fragrances. Try exploring our curated Flagship and Discovery collections below.
            </p>
            <div class="search-empty-actions">
              <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="btn btn-primary">
                Browse All Fragrances
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endpaginate -%}

    {%- else -%}

      {%- comment -%} Curated fragrance keywords {%- endcomment -%}
      <div class="search-discovery-pills text-center">
        <p class="discovery-pills-label">Explore Signature Scents & Notes:</p>
        <div class="discovery-pills-wrap">
          <a href="{{ routes.search_url }}?type=product&q=ADDICTED" class="discovery-pill">ADDICTED</a>
          <a href="{{ routes.search_url }}?type=product&q=Ice+of+Heaven" class="discovery-pill">Ice of Heaven</a>
          <a href="{{ routes.search_url }}?type=product&q=Rouge+Elite" class="discovery-pill">Rouge Elite</a>
          <a href="{{ routes.search_url }}?type=product&q=Purple+Mist" class="discovery-pill">Purple Mist</a>
          <a href="{{ routes.search_url }}?type=product&q=Old+Money" class="discovery-pill">Old Money</a>
          <a href="{{ routes.search_url }}?type=product&q=Fallen+Star" class="discovery-pill">Fallen Star</a>
          <a href="{{ routes.search_url }}?type=product&q=Coffee" class="discovery-pill">Coffee</a>
          <a href="{{ routes.search_url }}?type=product&q=Toxic" class="discovery-pill">Toxic</a>
          <a href="{{ routes.search_url }}?type=product&q=Dark+Chocolates" class="discovery-pill">Dark Chocolates</a>
        </div>
      </div>

    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "Search Main",
  "settings": []
}
{% endschema %}
