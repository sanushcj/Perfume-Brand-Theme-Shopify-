<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-main">

      {%- comment -%} Brand & Contact Column {%- endcomment -%}
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} - Home" class="footer-logo-link">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" width="140" height="auto" loading="lazy" style="max-height: 48px; width: auto;">
          {%- else -%}
            <span class="footer-logo-name">{{ section.settings.brand_name | default: settings.brand_name | default: 'AD PERFUMES' }}</span>
            <span class="footer-logo-tagline">{{ section.settings.brand_tagline | default: settings.brand_tagline | default: 'Your Fragrance. Your Vision. Your Brand.' }}</span>
          {%- endif -%}
        </a>
        <p class="footer-brand-desc">
          {{ section.settings.brand_desc | default: 'Crafting distinctive perfume experiences and premium fragrances. Discover your signature scent with AD PERFUMES.' }}
        </p>

        <div class="footer-contact-details">
          <div class="footer-contact-row">
            <span class="footer-contact-icon">📞</span>
            <a href="tel:{{ section.settings.phone | default: settings.contact_phone | default: '+918921362927' | remove: ' ' }}">
              {{ section.settings.phone | default: settings.contact_phone | default: '+91 89213 62927' }}
            </a>
          </div>
          <div class="footer-contact-row">
            <span class="footer-contact-icon">📧</span>
            <a href="mailto:{{ section.settings.email | default: settings.contact_email | default: 'Connect.adperfumes@gmail.com' }}">
              {{ section.settings.email | default: settings.contact_email | default: 'Connect.adperfumes@gmail.com' }}
            </a>
          </div>
          <div class="footer-contact-row">
            <span class="footer-contact-icon">📍</span>
            <span>{{ section.settings.regions | default: settings.contact_regions | default: 'Serving Kerala, Karnataka & UAE' }}</span>
          </div>
        </div>

        <div class="social-links" style="margin-top: var(--space-4);">
          {%- if settings.social_instagram_link != blank or section.settings.instagram_url != blank -%}
            <a
              href="{{ section.settings.instagram_url | default: settings.social_instagram_link | default: 'https://instagram.com/ad_.perfumes' }}"
              class="social-link"
              aria-label="Instagram"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_whatsapp_number != blank -%}
            <a href="https://wa.me/{{ settings.social_whatsapp_number }}" class="social-link" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Navigation Column 1 {%- endcomment -%}
      <div class="footer-column">
        <h3 class="footer-col-title">{{ section.settings.menu_1_heading | default: 'Collections' }}</h3>
        <ul class="footer-links" role="list">
          {%- assign menu_1 = section.settings.menu_1 | default: 'footer' -%}
          {%- if linklists[menu_1].links.size > 0 -%}
            {%- for link in linklists[menu_1].links -%}
              <li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="footer-link">All Fragrances</a></li>
            <li><a href="{{ routes.collections_url }}" class="footer-link">Browse Collections</a></li>
            <li><a href="{{ routes.search_url }}" class="footer-link">Search Fragrances</a></li>
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Navigation Column 2 {%- endcomment -%}
      <div class="footer-column">
        <h3 class="footer-col-title">{{ section.settings.menu_2_heading | default: 'Customer Care' }}</h3>
        <ul class="footer-links" role="list">
          {%- assign menu_2 = section.settings.menu_2 -%}
          {%- if menu_2 != blank and linklists[menu_2].links.size > 0 -%}
            {%- for link in linklists[menu_2].links -%}
              <li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>
            {%- endfor -%}
          {%- else -%}
            <li><a href="/pages/contact" class="footer-link">Contact Us</a></li>
            {%- if section.settings.show_business_link -%}
              <li><a href="{{ section.settings.business_link_url | default: '/pages/business-services' }}" class="footer-link">{{ section.settings.business_link_title | default: 'Bespoke & Business Solutions' }}</a></li>
            {%- endif -%}
          {%- endif -%}
        </ul>
      </div>

      {%- comment -%} Newsletter Column {%- endcomment -%}
      <div class="footer-column footer-newsletter-col">
        <h3 class="footer-col-title">{{ section.settings.newsletter_title | default: 'Stay Connected' }}</h3>
        <p class="footer-newsletter-text">
          {{ section.settings.newsletter_desc | default: 'Subscribe to receive updates on new scent releases and exclusive boutique announcements.' }}
        </p>

        {%- form 'customer', class: 'footer-newsletter-form', id: 'FooterNewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="newsletter-success" style="color: var(--color-gold); font-size: var(--text-sm);">✓ Thank you for subscribing!</p>
          {%- else -%}
            <div class="footer-input-wrap">
              <input
                type="email"
                name="contact[email]"
                id="FooterNewsletterEmail"
                class="footer-newsletter-input"
                placeholder="Enter your email"
                required
                autocomplete="email"
                aria-label="Email address"
              >
              <button type="submit" class="footer-newsletter-btn" aria-label="Subscribe">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </button>
            </div>
            {%- if form.errors -%}
              <p class="newsletter-error" style="color: var(--color-sale); font-size: var(--text-xs); margin-top: 4px;">{{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}
      </div>

    </div>

    {%- comment -%} Footer Bottom {%- endcomment -%}
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'AD PERFUMES' }}. All rights reserved.
      </p>

      {%- if shop.policies.size > 0 -%}
        <nav class="footer-legal" aria-label="Legal links">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <a href="{{ policy.url }}">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}

      <div class="footer-meta-note">
        <span>{{ section.settings.bottom_note | default: 'AD PERFUMES — Your Fragrance. Your Vision. Your Brand.' }}</span>
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "AD PERFUMES"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Your Fragrance. Your Vision. Your Brand."
    },
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand Description",
      "default": "Crafting distinctive perfume experiences and premium fragrances. Discover your signature scent with AD PERFUMES."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+91 89213 62927"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "Connect.adperfumes@gmail.com"
    },
    {
      "type": "text",
      "id": "regions",
      "label": "Service Regions",
      "default": "Serving Kerala, Karnataka & UAE"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile URL"
    },
    {
      "type": "header",
      "content": "Navigation Menus"
    },
    {
      "type": "text",
      "id": "menu_1_heading",
      "label": "Column 1 Heading",
      "default": "Collections"
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "Column 1 Menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "menu_2_heading",
      "label": "Column 2 Heading",
      "default": "Customer Care"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Column 2 Menu"
    },
    {
      "type": "header",
      "content": "Optional Business Services Link"
    },
    {
      "type": "checkbox",
      "id": "show_business_link",
      "label": "Show Business & Branding Link",
      "default": false
    },
    {
      "type": "text",
      "id": "business_link_title",
      "label": "Business Link Title",
      "default": "Bespoke & Private Label Solutions"
    },
    {
      "type": "url",
      "id": "business_link_url",
      "label": "Business Link Destination"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Heading",
      "default": "Stay Connected"
    },
    {
      "type": "textarea",
      "id": "newsletter_desc",
      "label": "Newsletter Description",
      "default": "Subscribe to receive updates on new scent releases and exclusive boutique announcements."
    },
    {
      "type": "text",
      "id": "bottom_note",
      "label": "Bottom Tagline Note",
      "default": "AD PERFUMES — Your Fragrance. Your Vision. Your Brand."
    }
  ]
}
{% endschema %}
