<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-main">

      {%- comment -%} Brand Column {%- endcomment -%}
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} - Home">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 160 }}" alt="{{ shop.name }}" width="160" height="40" loading="lazy" style="max-height: 40px; width: auto;">
          {%- else -%}
            <div class="nav-logo" style="text-decoration: none;">
              <span class="nav-logo-name">{{ settings.brand_name | default: shop.name }}</span>
              <span class="nav-logo-tagline">{{ settings.brand_tagline | default: 'Haute Parfumerie' }}</span>
            </div>
          {%- endif -%}
        </a>
        <p class="footer-brand-desc">
          {{ section.settings.brand_desc | default: 'Purveyors of rare and exceptional fragrances for those who understand that true luxury is found in the invisible.' }}
        </p>
        <div class="social-links">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_twitter_link != blank -%}
            <a href="{{ settings.social_twitter_link }}" class="social-link" aria-label="Twitter / X" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" class="social-link" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" class="social-link" aria-label="Pinterest" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 0 1 .083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Quick Links {%- endcomment -%}
      <div>
        <h3 class="footer-col-title">Shop</h3>
        <ul class="footer-links" role="list">
          <li><a href="{{ routes.collections_url }}/flagship" class="footer-link">New Flagships</a></li>
          <li><a href="{{ routes.collections_url }}/all" class="footer-link">All Fragrances</a></li>
          <li><a href="{{ routes.collections_url }}/for-him" class="footer-link">For Him</a></li>
          <li><a href="{{ routes.collections_url }}/for-her" class="footer-link">For Her</a></li>
          <li><a href="{{ routes.collections_url }}/unisex" class="footer-link">Unisex</a></li>
          <li><a href="{{ routes.collections_url }}/gift-sets" class="footer-link">Gift Sets</a></li>
        </ul>
      </div>

      {%- comment -%} Company {%- endcomment -%}
      <div>
        <h3 class="footer-col-title">Company</h3>
        <ul class="footer-links" role="list">
          <li><a href="{{ pages['about'].url | default: '/pages/about' }}" class="footer-link">About Us</a></li>
          <li><a href="{{ pages['contact'].url | default: '/pages/contact' }}" class="footer-link">Contact</a></li>
          <li><a href="{{ pages['our-story'].url | default: '/pages/our-story' }}" class="footer-link">Our Story</a></li>
          <li><a href="{{ pages['sustainability'].url | default: '#' }}" class="footer-link">Sustainability</a></li>
          <li><a href="{{ pages['press'].url | default: '#' }}" class="footer-link">Press</a></li>
          <li><a href="{{ routes.search_url }}" class="footer-link">Search</a></li>
        </ul>
      </div>

      {%- comment -%} Newsletter {%- endcomment -%}
      <div>
        <h3 class="footer-col-title">Inner Circle</h3>
        <p class="footer-newsletter-text">
          Subscribe for exclusive access to new releases, private events, and complimentary samples.
        </p>
        <form class="footer-newsletter-form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label for="FooterEmail" class="visually-hidden">Email address</label>
          <input
            type="email"
            name="contact[email]"
            id="FooterEmail"
            class="footer-newsletter-input"
            placeholder="Email address"
            required
            autocomplete="email"
          >
          <button type="submit" class="footer-newsletter-btn" aria-label="Subscribe to newsletter">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </form>
      </div>

    </div>

    {%- comment -%} Footer Bottom {%- endcomment -%}
    <div class="footer-bottom">
      <p class="footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </p>

      <nav class="footer-legal" aria-label="Legal links">
        <a href="{{ pages['privacy-policy'].url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
        <a href="{{ pages['terms'].url | default: '/policies/terms-of-service' }}">Terms of Service</a>
        <a href="{{ pages['refund-policy'].url | default: '/policies/refund-policy' }}">Returns</a>
        <a href="{{ pages['shipping-policy'].url | default: '/policies/shipping-policy' }}">Shipping</a>
      </nav>

      <div style="font-size: var(--text-xs); color: var(--color-text-muted);">
        {{ section.settings.currency_note | default: 'All prices in USD. Free shipping over $150.' }}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo"
    },
    {
      "type": "textarea",
      "id": "brand_desc",
      "label": "Brand description"
    },
    {
      "type": "text",
      "id": "currency_note",
      "label": "Currency/shipping note",
      "default": "All prices in USD. Free shipping over $150."
    }
  ]
}
{% endschema %}
