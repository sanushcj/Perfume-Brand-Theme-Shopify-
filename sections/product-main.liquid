{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign product_form_id = 'product-form-' | append: product.id -%}

<div class="product-page" data-section-id="{{ section.id }}" data-section-type="product">
  <div class="container">

    {%- render 'breadcrumbs', type: 'product' -%}

    <div class="product-layout">

      {%- comment -%} === GALLERY COLUMN === {%- endcomment -%}
      <div class="product-gallery">
        <div class="product-gallery-main">
          {%- if product.featured_image -%}
            <img
              id="ProductMainImage"
              src="{{ product.featured_image | image_url: width: 1000 }}"
              alt="{{ product.featured_image.alt | default: product.title | escape }}"
              class="product-main-image"
              loading="eager"
              fetchpriority="high"
              width="1000"
              height="1250"
            >
          {%- else -%}
            <div class="product-main-image-placeholder">
              <span class="placeholder-icon">✦</span>
              <p>AD PERFUMES</p>
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-thumbnails" role="list" aria-label="Product thumbnails">
            {%- for image in product.images -%}
              <button
                type="button"
                class="product-thumbnail-btn{% if forloop.first %} active{% endif %}"
                data-target-src="{{ image | image_url: width: 1000 }}"
                aria-label="View photo {{ forloop.index }} of {{ product.title | escape }}"
              >
                <img
                  src="{{ image | image_url: width: 160 }}"
                  alt="{{ image.alt | default: product.title | escape }}"
                  class="product-thumbnail-img"
                  loading="lazy"
                  width="80"
                  height="100"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} === PRODUCT DETAILS COLUMN === {%- endcomment -%}
      <div class="product-info">

        {%- if section.settings.show_vendor and product.vendor != blank -%}
          <div class="product-info-vendor">{{ product.vendor }}</div>
        {%- elsif product.type != blank -%}
          <div class="product-info-category">{{ product.type }}</div>
        {%- endif -%}

        <h1 class="product-info-title">{{ product.title }}</h1>

        {%- comment -%} Price Block {%- endcomment -%}
        <div class="product-price-block" id="ProductPriceBlock">
          <span class="product-price-main" id="ProductPrice">
            {{ current_variant.price | money }}
          </span>

          <s
            class="product-price-original{% unless current_variant.compare_at_price > current_variant.price %} hide{% endunless %}"
            id="ProductComparePrice"
          >
            {%- if current_variant.compare_at_price > current_variant.price -%}
              {{ current_variant.compare_at_price | money }}
            {%- endif -%}
          </s>

          <span
            class="product-price-save{% unless current_variant.compare_at_price > current_variant.price %} hide{% endunless %}"
            id="ProductSaveBadge"
          >
            {%- if current_variant.compare_at_price > current_variant.price -%}
              Save {{ current_variant.compare_at_price | minus: current_variant.price | money }}
            {%- endif -%}
          </span>
        </div>

        {%- comment -%} Availability Banner {%- endcomment -%}
        <div class="product-stock-status" id="ProductStockStatus">
          {%- if current_variant.available -%}
            <span class="stock-indicator in-stock"></span>
            <span class="stock-label">In Stock • Ready to Dispatch</span>
          {%- else -%}
            <span class="stock-indicator out-of-stock"></span>
            <span class="stock-label">Currently Out of Stock</span>
          {%- endif -%}
        </div>

        {%- comment -%} Shopify Native Product Form {%- endcomment -%}
        {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate', data-product-form: '' -%}

          {%- comment -%} Variant & Size Selectors {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            <div class="product-options-wrapper">
              {%- for option in product.options_with_values -%}
                <div class="product-option-group" data-option-index="{{ forloop.index0 }}">
                  <div class="product-option-header">
                    <span class="product-option-title">{{ option.name }}:</span>
                    <span class="product-option-selected" id="OptionSelectedValue-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                  </div>

                  <div class="product-option-pills" role="radiogroup" aria-label="{{ option.name }}">
                    {%- for value in option.values -%}
                      <button
                        type="button"
                        class="option-pill{% if option.selected_value == value %} active{% endif %}"
                        data-option-index="{{ forloop.parentloop.index0 }}"
                        data-option-value="{{ value | escape }}"
                        role="radio"
                        aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                      >
                        {{ value }}
                      </button>
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductSelectedVariantId">

          {%- comment -%} Quantity & Add to Bag Row {%- endcomment -%}
          <div class="product-action-row">
            <div class="quantity-selector product-qty-selector" role="group" aria-label="Quantity">
              <button type="button" class="qty-btn" data-action="decrease" aria-label="Decrease quantity">−</button>
              <input
                type="number"
                name="quantity"
                class="qty-input"
                id="ProductQuantityInput"
                value="1"
                min="1"
                max="99"
                aria-label="Quantity"
              >
              <button type="button" class="qty-btn" data-action="increase" aria-label="Increase quantity">+</button>
            </div>

            <button
              type="submit"
              name="add"
              class="btn btn-primary btn-lg product-add-to-cart-btn"
              id="ProductAddToCartBtn"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span class="btn-text">
                {%- if current_variant.available -%}
                  Add to Shopping Bag
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </span>
              <span class="btn-spinner hide"></span>
            </button>
          </div>

          {%- if section.settings.show_dynamic_checkout and current_variant.available -%}
            <div class="product-dynamic-checkout">
              {{ form | payment_button }}
            </div>
          {%- endif -%}

        {%- endform -%}

        {%- comment -%} Service Highlights {%- endcomment -%}
        <div class="product-perks-box">
          <div class="perk-item">
            <span class="perk-icon">🌿</span>
            <div class="perk-text">
              <strong>Premium Fragrance</strong>
              <span>Distinctive oils & fine craftsmanship</span>
            </div>
          </div>
          <div class="perk-item">
            <span class="perk-icon">🚚</span>
            <div class="perk-text">
              <strong>Regional Dispatch</strong>
              <span>Fast service to Kerala, Karnataka & UAE</span>
            </div>
          </div>
          <div class="perk-item">
            <span class="perk-icon">✨</span>
            <div class="perk-text">
              <strong>AD PERFUMES Quality</strong>
              <span>Pure fragrance experience</span>
            </div>
          </div>
        </div>

        {%- comment -%} Accordion Tabs {%- endcomment -%}
        <div class="product-accordion">

          <details class="accordion-item" open>
            <summary class="accordion-summary">
              <span>Fragrance Description</span>
              <span class="accordion-arrow">▼</span>
            </summary>
            <div class="accordion-content">
              {%- if product.description != blank -%}
                <div class="rte">{{ product.description }}</div>
              {%- else -%}
                <p>An exquisite fragrance creation by AD PERFUMES, composed with masterfully balanced notes to leave an unforgettable aura.</p>
              {%- endif -%}
            </div>
          </details>

          {%- if section.settings.show_care_tab -%}
            <details class="accordion-item">
              <summary class="accordion-summary">
                <span>Application & Fragrance Care</span>
                <span class="accordion-arrow">▼</span>
              </summary>
              <div class="accordion-content">
                <p>Apply to pulse points — the wrists, base of the throat, behind earlobes, and inside elbows — where body warmth naturally projects the scent. Store in a cool, dry environment away from direct sunlight to preserve essence longevity.</p>
              </div>
            </details>
          {%- endif -%}

          {%- if section.settings.show_delivery_tab -%}
            <details class="accordion-item">
              <summary class="accordion-summary">
                <span>Dispatch & Support</span>
                <span class="accordion-arrow">▼</span>
              </summary>
              <div class="accordion-content">
                <p><strong>Service Regions:</strong> Kerala, Karnataka, and UAE.</p>
                <p>For custom orders, bulk gifting, or customer inquiries, contact our boutique concierge:</p>
                <p>📞 Phone: <a href="tel:+918921362927">+91 89213 62927</a><br>
                📧 Email: <a href="mailto:Connect.adperfumes@gmail.com">Connect.adperfumes@gmail.com</a><br>
                📲 Instagram: <a href="https://instagram.com/ad_.perfumes" target="_blank">@ad_.perfumes</a></p>
              </div>
            </details>
          {%- endif -%}

        </div>

      </div>

    </div>

  </div>
</div>

{%- comment -%} Embedded Product JSON for Live Variant Switching {%- endcomment -%}
<script type="application/json" id="ProductJson-{{ product.id }}">
  {{ product | json }}
</script>

{% schema %}
{
  "name": "Product Main",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Perfume Vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show Dynamic Checkout Button",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_care_tab",
      "label": "Show Application & Care Tab",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_delivery_tab",
      "label": "Show Dispatch & Support Tab",
      "default": true
    }
  ]
}
{% endschema %}
