<div class="contact-page" data-section-id="{{ section.id }}" data-section-type="page-contact">
  <div class="container">

    <div class="contact-layout">

      {%- comment -%} Contact Information Column {%- endcomment -%}
      <div class="contact-info">
        <div class="contact-intro reveal">
          <p class="section-eyebrow">{{ section.settings.eyebrow | default: 'Concierge & Inquiries' }}</p>
          <h1 class="section-title">{{ section.settings.title | default: 'Connect with AD PERFUMES' }}</h1>
          <p class="section-subtitle">
            {{ section.settings.intro_text | default: 'Have a question about our fragrance collections, custom gifting, or personal recommendations? We are pleased to assist you.' }}
          </p>
        </div>

        <div class="contact-items reveal reveal-delay-1">

          <div class="contact-item">
            <div class="contact-item-icon">📞</div>
            <div class="contact-item-content">
              <div class="contact-item-label">Telephone Consultation</div>
              <a href="tel:{{ section.settings.phone | default: settings.contact_phone | default: '+918921362927' | remove: ' ' }}" class="contact-item-value">
                {{ section.settings.phone | default: settings.contact_phone | default: '+91 89213 62927' }}
              </a>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon">📧</div>
            <div class="contact-item-content">
              <div class="contact-item-label">Email Concierge</div>
              <a href="mailto:{{ section.settings.email | default: settings.contact_email | default: 'Connect.adperfumes@gmail.com' }}" class="contact-item-value">
                {{ section.settings.email | default: settings.contact_email | default: 'Connect.adperfumes@gmail.com' }}
              </a>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon">📍</div>
            <div class="contact-item-content">
              <div class="contact-item-label">Active Service Regions</div>
              <span class="contact-item-value">
                {{ section.settings.regions | default: settings.contact_regions | default: 'Kerala, Karnataka & UAE' }}
              </span>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon">📲</div>
            <div class="contact-item-content">
              <div class="contact-item-label">Instagram Community</div>
              <a href="{{ section.settings.instagram_link | default: settings.social_instagram_link | default: 'https://instagram.com/ad_.perfumes' }}" target="_blank" rel="noopener" class="contact-item-value">
                {{ section.settings.instagram_handle | default: settings.contact_instagram_handle | default: '@ad_.perfumes' }}
              </a>
            </div>
          </div>

        </div>
      </div>

      {%- comment -%} Contact Form Column {%- endcomment -%}
      <div class="contact-form-column reveal reveal-delay-2">
        <div class="contact-form-wrapper">
          <h2 class="contact-form-heading">Send a Message</h2>

          {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
            {%- if form.posted_successfully? -%}
              <div class="contact-form-alert success" role="alert">
                ✓ Thank you for reaching out to AD PERFUMES. Our concierge team will respond shortly.
              </div>
            {%- else -%}
              {%- if form.errors -%}
                <div class="contact-form-alert error" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="form-row">
                <div class="form-field">
                  <label for="ContactFormName" class="form-label">Full Name *</label>
                  <input
                    type="text"
                    id="ContactFormName"
                    name="contact[name]"
                    class="form-input"
                    value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
                    required
                    autocomplete="name"
                    placeholder="Your name"
                  >
                </div>

                <div class="form-field">
                  <label for="ContactFormEmail" class="form-label">Email Address *</label>
                  <input
                    type="email"
                    id="ContactFormEmail"
                    name="contact[email]"
                    class="form-input"
                    value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                    required
                    autocomplete="email"
                    placeholder="your.email@example.com"
                  >
                </div>
              </div>

              <div class="form-field">
                <label for="ContactFormPhone" class="form-label">Phone Number (Optional)</label>
                <input
                  type="tel"
                  id="ContactFormPhone"
                  name="contact[phone]"
                  class="form-input"
                  value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                  autocomplete="tel"
                  placeholder="+91..."
                >
              </div>

              <div class="form-field">
                <label for="ContactFormMessage" class="form-label">Your Message *</label>
                <textarea
                  id="ContactFormMessage"
                  name="contact[body]"
                  class="form-textarea"
                  rows="5"
                  required
                  placeholder="How can we assist you with our fragrances or orders?"
                >{{ form.body }}</textarea>
              </div>

              <button type="submit" class="btn btn-primary btn-full btn-lg" id="ContactFormSubmitBtn">
                <span>Send Message</span>
              </button>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Concierge & Inquiries"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Connect with AD PERFUMES"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro Text",
      "default": "Have a question about our fragrance collections, custom gifting, or personal recommendations? We are pleased to assist you."
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+91 89213 62927"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "Connect.adperfumes@gmail.com"
    },
    {
      "type": "text",
      "id": "regions",
      "label": "Service Regions",
      "default": "Kerala, Karnataka & UAE"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Handle",
      "default": "@ad_.perfumes"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram Link",
      "default": "https://instagram.com/ad_.perfumes"
    }
  ]
}
{% endschema %}
