<div class="contact-page">
  <div class="container">

    <div class="contact-layout">

      {%- comment -%} Contact Info {%- endcomment -%}
      <div class="contact-info">
        <div class="contact-intro reveal">
          <p class="section-eyebrow">Get in Touch</p>
          <h1 class="section-title">We'd Love to<br>Hear From You</h1>
          <p class="section-subtitle">
            {{ section.settings.intro_text | default: 'Whether you have a question about our fragrances, need help choosing the perfect gift, or would like to explore our private consultation service — our team is here to assist.' }}
          </p>
        </div>

        <div class="contact-items reveal reveal-delay-1">

          <div class="contact-item">
            <div class="contact-item-icon">📧</div>
            <div class="contact-item-content">
              <div class="contact-item-label">Email</div>
              <a href="mailto:{{ section.settings.email | default: 'hello@lumierenoir.com' }}" class="contact-item-value">
                {{ section.settings.email | default: 'hello@lumierenoir.com' }}
              </a>
            </div>
          </div>

          {%- if section.settings.phone != blank -%}
            <div class="contact-item">
              <div class="contact-item-icon">📞</div>
              <div class="contact-item-content">
                <div class="contact-item-label">Phone</div>
                <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '-' }}" class="contact-item-value">
                  {{ section.settings.phone }}
                </a>
              </div>
            </div>
          {%- else -%}
            <div class="contact-item">
              <div class="contact-item-icon">📞</div>
              <div class="contact-item-content">
                <div class="contact-item-label">Phone</div>
                <span class="contact-item-value">+1 (800) 555-NOIR</span>
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.address != blank -%}
            <div class="contact-item">
              <div class="contact-item-icon">📍</div>
              <div class="contact-item-content">
                <div class="contact-item-label">Address</div>
                <span class="contact-item-value">{{ section.settings.address }}</span>
              </div>
            </div>
          {%- else -%}
            <div class="contact-item">
              <div class="contact-item-icon">📍</div>
              <div class="contact-item-content">
                <div class="contact-item-label">Atelier</div>
                <span class="contact-item-value">12 Rue du Faubourg<br>Paris, France 75008</span>
              </div>
            </div>
          {%- endif -%}

          <div class="contact-item">
            <div class="contact-item-icon">⏰</div>
            <div class="contact-item-content">
              <div class="contact-item-label">Business Hours</div>
              <span class="contact-item-value">
                {{ section.settings.hours | default: 'Mon – Fri: 9am – 6pm CET' }}
              </span>
            </div>
          </div>

        </div>

        <div class="contact-social reveal reveal-delay-2">
          <p class="contact-social-title">Follow Our Journey</p>
          <div class="social-links">
            {%- if settings.social_instagram_link != blank -%}
              <a href="{{ settings.social_instagram_link }}" class="social-link" aria-label="Instagram" target="_blank" rel="noopener">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
            {%- else -%}
              <a href="#" class="social-link" aria-label="Instagram">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
              </a>
              <a href="#" class="social-link" aria-label="Twitter / X">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="#" class="social-link" aria-label="Facebook">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </div>

        {%- if section.settings.show_map and section.settings.map_embed != blank -%}
          <div class="reveal reveal-delay-3" style="border-radius: var(--radius-xl); overflow: hidden; border: 1px solid var(--color-border);">
            {{ section.settings.map_embed }}
          </div>
        {%- endif -%}

      </div>

      {%- comment -%} Contact Form {%- endcomment -%}
      <div class="contact-form-wrapper reveal reveal-delay-1">
        <div style="margin-bottom: var(--space-8);">
          <h2 style="font-family: var(--font-display); font-size: var(--text-3xl); font-weight: var(--fw-medium); color: var(--color-text-primary); margin-bottom: var(--space-2);">Send a Message</h2>
          <p style="font-size: var(--text-sm); color: var(--color-text-muted);">We typically respond within 24 hours.</p>
        </div>

        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
            <div style="padding: var(--space-6); background: rgba(82, 160, 110, 0.1); border: 1px solid rgba(82, 160, 110, 0.3); border-radius: var(--radius-xl); text-align: center; margin-bottom: var(--space-6);">
              <div style="font-size: 32px; margin-bottom: var(--space-3);">✓</div>
              <p style="color: var(--color-success); font-weight: var(--fw-medium);">Your message has been sent. We'll be in touch shortly.</p>
            </div>
          {%- endif -%}

          <div class="contact-form">

            <div class="form-row">
              <div class="form-group">
                <label for="ContactFirstName" class="form-label">First Name *</label>
                <input
                  type="text"
                  name="contact[first_name]"
                  id="ContactFirstName"
                  class="form-input"
                  placeholder="Jean"
                  required
                  autocomplete="given-name"
                  value="{{ form.first_name }}"
                >
              </div>
              <div class="form-group">
                <label for="ContactLastName" class="form-label">Last Name</label>
                <input
                  type="text"
                  name="contact[last_name]"
                  id="ContactLastName"
                  class="form-input"
                  placeholder="Dupont"
                  autocomplete="family-name"
                  value="{{ form.last_name }}"
                >
              </div>
            </div>

            <div class="form-group">
              <label for="ContactEmail" class="form-label">Email Address *</label>
              <input
                type="email"
                name="contact[email]"
                id="ContactEmail"
                class="form-input"
                placeholder="jean@example.com"
                required
                autocomplete="email"
                value="{{ form.email }}"
                aria-required="true"
              >
            </div>

            <div class="form-group">
              <label for="ContactPhone" class="form-label">Phone Number</label>
              <input
                type="tel"
                name="contact[phone]"
                id="ContactPhone"
                class="form-input"
                placeholder="+1 (555) 000-0000"
                autocomplete="tel"
                value="{{ form.phone }}"
              >
            </div>

            <div class="form-group">
              <label for="ContactSubject" class="form-label">Subject</label>
              <select name="contact[subject]" id="ContactSubject" class="form-select">
                <option value="">Select a topic</option>
                <option value="product-inquiry">Product Inquiry</option>
                <option value="order-support">Order Support</option>
                <option value="private-consultation">Private Consultation</option>
                <option value="wholesale">Wholesale & Retail</option>
                <option value="press">Press & Media</option>
                <option value="gift-service">Gift & Corporate</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="ContactMessage" class="form-label">Message *</label>
              <textarea
                name="contact[body]"
                id="ContactMessage"
                class="form-textarea"
                placeholder="Tell us how we can help you..."
                required
                aria-required="true"
              >{{ form.body }}</textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-full btn-lg" id="ContactSubmit">
              Send Message
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 2L11 13M22 2L15 22 11 13 2 9z"/></svg>
            </button>

          </div>
        {%- endform -%}
      </div>

    </div>

  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro text"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Contact email",
      "default": "hello@lumierenoir.com"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Business hours",
      "default": "Mon – Fri: 9am – 6pm CET"
    },
    {
      "type": "checkbox",
      "id": "show_map",
      "label": "Show map",
      "default": false
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Google Maps embed code"
    }
  ]
}
{% endschema %}
