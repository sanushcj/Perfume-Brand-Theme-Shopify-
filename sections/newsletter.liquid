<section class="newsletter section-padding" id="newsletter-{{ section.id }}" aria-label="Newsletter">
  <div class="container">
    <div class="newsletter-inner reveal">
      <div class="newsletter-content text-center">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-eyebrow justify-center">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="section-title">{{ section.settings.title | default: 'Stay Connected With AD PERFUMES' }}</h2>

        {%- if section.settings.subtitle != blank -%}
          <p class="section-subtitle max-w-prose">{{ section.settings.subtitle }}</p>
        {%- endif -%}

        {%- form 'customer', class: 'newsletter-form', id: 'NewsletterForm' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <div class="newsletter-message success" role="alert">
              ✓ Thank you for subscribing to AD PERFUMES!
            </div>
          {%- else -%}
            <div class="newsletter-input-group">
              <label for="NewsletterEmail-{{ section.id }}" class="visually-hidden">Email address</label>
              <input
                type="email"
                name="contact[email]"
                id="NewsletterEmail-{{ section.id }}"
                class="newsletter-input"
                placeholder="{{ section.settings.placeholder | default: 'Enter your email address' }}"
                required
                autocomplete="email"
                aria-label="Email address"
              >
              <button type="submit" class="btn btn-primary" id="NewsletterSubmitBtn">
                <span>{{ section.settings.button_label | default: 'Subscribe' }}</span>
              </button>
            </div>

            {%- if form.errors -%}
              <div class="newsletter-message error" role="alert">
                {{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.disclaimer != blank -%}
          <p class="newsletter-disclaimer">
            {{ section.settings.disclaimer }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "AD PERFUMES Bulletin"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join the AD PERFUMES Circle"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Subscribe for early announcements, new fragrance releases, and exclusive boutique updates."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "Your privacy is respected. You can unsubscribe at any time."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
