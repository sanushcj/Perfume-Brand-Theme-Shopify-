<section class="category-spotlight section-padding" id="categories-{{ section.id }}" aria-label="Collections">
  <div class="container">

    <div class="section-header text-center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow justify-center">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: 'Fragrance Categories' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle max-w-prose">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="spotlight-grid">

      {%- comment -%} Card 1: The Signature Collection {%- endcomment -%}
      {%- assign col_1 = collections[section.settings.card_1_collection] -%}
      {%- assign card_1_url = section.settings.card_1_url | default: col_1.url | default: '/collections' -%}
      <div class="spotlight-card reveal reveal-delay-1">
        <div class="spotlight-media">
          {%- if section.settings.card_1_image != blank -%}
            <img
              src="{{ section.settings.card_1_image | image_url: width: 900 }}"
              alt="{{ section.settings.card_1_title | default: 'The Signature Collection' | escape }}"
              class="spotlight-img"
              loading="lazy"
              width="900"
              height="750"
            >
          {%- elsif col_1.image != blank -%}
            <img
              src="{{ col_1.image | image_url: width: 900 }}"
              alt="{{ col_1.title | escape }}"
              class="spotlight-img"
              loading="lazy"
              width="900"
              height="750"
            >
          {%- else -%}
            <img
              src="{{ 'product-rouge-elite.jpg' | asset_url }}"
              alt="The Signature Collection — AD PERFUMES"
              class="spotlight-img"
              loading="lazy"
              width="900"
              height="750"
            >
          {%- endif -%}
          <div class="spotlight-gradient-overlay"></div>
        </div>

        <div class="spotlight-content">
          <span class="spotlight-badge">{{ section.settings.card_1_badge | default: '50ML FLAGSHIPS' }}</span>
          <h3 class="spotlight-heading">{{ section.settings.card_1_title | default: 'The Signature Collection' }}</h3>
          <p class="spotlight-desc">
            {{ section.settings.card_1_desc | default: 'Our three flagship creations: ADDICTED, Ice of Heaven, and Rouge Elite. Deep, warm woods, icy marine accords, and decadent caramelized ambers in 50ml flacons.' }}
          </p>

          <a href="{{ card_1_url }}" class="btn btn-primary btn-sm spotlight-cta">
            <span>{{ section.settings.card_1_btn_label | default: 'Explore 50ml Collection' }}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      {%- comment -%} Card 2: The Discovery Collection {%- endcomment -%}
      {%- assign col_2 = collections[section.settings.card_2_collection] -%}
      {%- assign card_2_url = section.settings.card_2_url | default: col_2.url | default: '/collections' -%}
      <div class="spotlight-card reveal reveal-delay-2">
        <div class="spotlight-media">
          {%- if section.settings.card_2_image != blank -%}
            <img
              src="{{ section.settings.card_2_image | image_url: width: 900 }}"
              alt="{{ section.settings.card_2_title | default: 'The Discovery Collection' | escape }}"
              class="spotlight-img"
              loading="lazy"
              width="900"
              height="750"
            >
          {%- elsif col_2.image != blank -%}
            <img
              src="{{ col_2.image | image_url: width: 900 }}"
              alt="{{ col_2.title | escape }}"
              class="spotlight-img"
              loading="lazy"
              width="900"
              height="750"
            >
          {%- else -%}
            <img
              src="{{ 'discovery-travel-set.jpg' | asset_url }}"
              alt="The Discovery Collection — AD PERFUMES"
              class="spotlight-img"
              loading="lazy"
              width="900"
              height="750"
            >
          {%- endif -%}
          <div class="spotlight-gradient-overlay"></div>
        </div>

        <div class="spotlight-content">
          <span class="spotlight-badge">{{ section.settings.card_2_badge | default: '10ML / 20ML EDITIONS' }}</span>
          <h3 class="spotlight-heading">{{ section.settings.card_2_title | default: 'The Discovery Collection' }}</h3>
          <p class="spotlight-desc">
            {{ section.settings.card_2_desc | default: 'Six versatile smaller-format scents: Purple Mist, Old Money, Fallen Star, Coffee, Toxic, and Dark Chocolates. Perfect for pocket portability and daily versatility.' }}
          </p>

          <a href="{{ card_2_url }}" class="btn btn-primary btn-sm spotlight-cta">
            <span>{{ section.settings.card_2_btn_label | default: 'Explore Discovery Collection' }}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Section Eyebrow",
      "default": "AD PERFUMES Collections"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Explore By Category"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Discover our signature 50ml flagship extraits alongside our versatile 10ml & 20ml Discovery line."
    },
    {
      "type": "header",
      "content": "Card 1: The Signature Collection (50ml)"
    },
    {
      "type": "collection",
      "id": "card_1_collection",
      "label": "Assign Collection"
    },
    {
      "type": "image_picker",
      "id": "card_1_image",
      "label": "Card 1 Background Image"
    },
    {
      "type": "text",
      "id": "card_1_badge",
      "label": "Badge",
      "default": "50ML FLAGSHIPS"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "label": "Heading",
      "default": "The Signature Collection"
    },
    {
      "type": "textarea",
      "id": "card_1_desc",
      "label": "Description",
      "default": "Our three flagship creations: ADDICTED, Ice of Heaven, and Rouge Elite. Deep, warm woods, icy marine accords, and decadent caramelized ambers in 50ml flacons."
    },
    {
      "type": "text",
      "id": "card_1_btn_label",
      "label": "Button Label",
      "default": "Explore 50ml Collection"
    },
    {
      "type": "url",
      "id": "card_1_url",
      "label": "Custom URL Destination (Optional)"
    },
    {
      "type": "header",
      "content": "Card 2: The Discovery Collection (10ml & 20ml)"
    },
    {
      "type": "collection",
      "id": "card_2_collection",
      "label": "Assign Collection"
    },
    {
      "type": "image_picker",
      "id": "card_2_image",
      "label": "Card 2 Background Image"
    },
    {
      "type": "text",
      "id": "card_2_badge",
      "label": "Badge",
      "default": "10ML / 20ML EDITIONS"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "label": "Heading",
      "default": "The Discovery Collection"
    },
    {
      "type": "textarea",
      "id": "card_2_desc",
      "label": "Description",
      "default": "Six versatile smaller-format scents: Purple Mist, Old Money, Fallen Star, Coffee, Toxic, and Dark Chocolates. Perfect for pocket portability and daily versatility."
    },
    {
      "type": "text",
      "id": "card_2_btn_label",
      "label": "Button Label",
      "default": "Explore Discovery Collection"
    },
    {
      "type": "url",
      "id": "card_2_url",
      "label": "Custom URL Destination (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Category Spotlight"
    }
  ]
}
{% endschema %}
