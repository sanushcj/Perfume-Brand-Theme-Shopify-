<div class="about-page" data-section-id="{{ section.id }}" data-section-type="page-about">
  <div class="container section-padding">

    <div class="about-header text-center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow justify-center">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="section-title">{{ section.settings.title | default: 'The World of AD PERFUMES' }}</h1>
      <p class="section-subtitle max-w-prose">
        {{ section.settings.tagline | default: 'Your Fragrance. Your Vision. Your Brand.' }}
      </p>
    </div>

    <div class="about-grid">
      <div class="about-media reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ shop.name }}" class="about-img" loading="lazy" width="800" height="900">
        {%- else -%}
          <img src="{{ 'hero-perfume.jpg' | asset_url }}" alt="AD PERFUMES Luxury Craft" class="about-img" loading="lazy" width="800" height="900">
        {%- endif -%}
      </div>

      <div class="about-narrative reveal reveal-delay-1">
        <h2 class="narrative-heading">{{ section.settings.narrative_heading | default: 'Crafted for Distinctive Presence' }}</h2>
        <div class="narrative-body">
          {%- if section.settings.narrative_text != blank -%}
            {{ section.settings.narrative_text }}
          {%- else -%}
            <p>
              At <strong>AD PERFUMES</strong>, our mission is to craft exceptional fragrances that leave an indelible mark. We combine deep woods, radiant saffron, crisp frozen fruit notes, and rich gourmands to create scent signatures that speak of confidence, sophistication, and refined taste.
            </p>
            <p style="margin-top: var(--space-4);">
              From our flagship 50ml Extraits — <strong>ADDICTED</strong>, <strong>Ice of Heaven</strong>, and <strong>Rouge Elite</strong> — to our versatile 10ml & 20ml Discovery Travel editions, every perfume is formulated with meticulous attention to detail.
            </p>
            <p style="margin-top: var(--space-4);">
              Currently serving clients across <strong>Kerala, Karnataka, and the UAE</strong>, we are committed to delivering an elevated luxury perfume experience with every bottle.
            </p>
          {%- endif -%}
        </div>

        <div class="about-cta-row" style="margin-top: var(--space-6);">
          <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="btn btn-primary">
            Explore Fragrance Portfolio
          </a>
          <a href="/pages/contact" class="btn btn-outline">
            Contact Concierge
          </a>
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "About Page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "Haute Parfumerie"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The World of AD PERFUMES"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Your Fragrance. Your Vision. Your Brand."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Feature Image"
    },
    {
      "type": "text",
      "id": "narrative_heading",
      "label": "Narrative Heading",
      "default": "Crafted for Distinctive Presence"
    },
    {
      "type": "textarea",
      "id": "narrative_text",
      "label": "Narrative Body Text"
    }
  ]
}
{% endschema %}
