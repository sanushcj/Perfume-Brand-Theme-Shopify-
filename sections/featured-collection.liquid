{%- assign selected_collection = collections[section.settings.collection] -%}

<section class="featured-products section-padding" id="bestsellers" aria-label="Featured Fragrances">
  <div class="container">

    <div class="section-header text-center reveal">
      <p class="section-eyebrow" style="justify-content: center;">{{ section.settings.eyebrow | default: 'Our Signature Blends' }}</p>
      <h2 class="section-title">{{ section.settings.title | default: 'Best Sellers & Icons' }}</h2>
      <p class="section-subtitle" style="margin: 0 auto;">
        {{ section.settings.subtitle | default: 'Experience the most coveted fragrances, meticulously distilled and aged for unmatched depth.' }}
      </p>
    </div>

    <div class="products-grid">
      {%- if selected_collection != blank and selected_collection.products_count > 0 -%}
        {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
          <div class="product-grid-col reveal reveal-delay-{{ forloop.index | modulo: 4 | plus: 1 }}">
            {%- render 'product-card', product_card_product: product, dummy_index: forloop.index -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Seamless Dummy Luxury Products for instant preview {%- endcomment -%}
        {%- assign fallback_count = section.settings.products_to_show | default: 8 -%}
        {%- for i in (1..fallback_count) -%}
          <div class="product-grid-col reveal reveal-delay-{{ forloop.index | modulo: 4 | plus: 1 }}">
            {%- render 'product-card', product_card_product: nil, dummy_index: i -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      <div class="section-footer-actions text-center reveal">
        <a href="{{ selected_collection.url | default: routes.collections_url }}" class="btn btn-outline btn-lg">
          {{ section.settings.view_all_label | default: 'View All Fragrances' }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Signature Blends"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Best Sellers & Icons"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section subtitle",
      "default": "Experience the most coveted fragrances, meticulously distilled and aged for unmatched depth."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 4,
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all button text",
      "default": "View All Fragrances"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
