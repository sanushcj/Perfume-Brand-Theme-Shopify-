{%- assign selected_collection = collections[section.settings.collection] -%}

<section class="featured-collection section-padding" id="collection-{{ section.id }}" aria-label="Featured Collection">
  <div class="container">

    <div class="section-header text-center reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-eyebrow justify-center">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="section-title">{{ section.settings.title | default: 'Featured Collection' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="section-subtitle max-w-prose">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="product-grid" id="FeaturedGrid-{{ section.id }}">
      {%- if selected_collection != blank and selected_collection.products.size > 0 -%}
        {%- for product in selected_collection.products limit: section.settings.products_to_show -%}
          <div class="reveal reveal-delay-{{ forloop.index | modulo: 4 | plus: 1 }}">
            {%- render 'product-card', product_card_product: product -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_count = section.settings.products_to_show | default: 6 -%}
        {%- for i in (1..fallback_count) -%}
          <div class="reveal reveal-delay-{{ forloop.index | modulo: 4 | plus: 1 }}">
            {%- render 'product-card', product_card_product: nil, dummy_index: i -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all -%}
      {%- assign view_all_target = section.settings.custom_url | default: selected_collection.url | default: routes.all_products_collection_url | default: '/collections/all' -%}
      <div class="section-footer-cta text-center reveal">
        <a href="{{ view_all_target }}" class="btn btn-outline btn-lg">
          <span>{{ section.settings.view_all_label | default: 'View All Fragrances' }}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "AD PERFUMES Atelier"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Fragrances"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Explore our curated fragrance selection, crafted with rare absolutes for unmatched presence."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Shopify Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Button Label",
      "default": "View All Fragrances"
    },
    {
      "type": "url",
      "id": "custom_url",
      "label": "Custom Button Destination (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
