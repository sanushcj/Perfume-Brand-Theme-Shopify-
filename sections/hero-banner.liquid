<section class="hero-section" id="hero-{{ section.id }}" aria-label="Hero">
  <div class="container hero-container">
    <div class="hero-grid">

      {%- comment -%} Hero Narrative Column {%- endcomment -%}
      <div class="hero-content reveal">
        {%- if section.settings.eyebrow != blank -%}
          <div class="hero-pill">
            <span class="hero-pill-dot"></span>
            <span>{{ section.settings.eyebrow }}</span>
          </div>
        {%- endif -%}

        <h1 class="hero-heading">
          <span class="hero-heading-main">{{ section.settings.heading_line1 | default: 'Distinctive Fragrances' }}</span>
          <span class="hero-heading-accent">{{ section.settings.heading_line2 | default: 'Crafted with Precision' }}</span>
        </h1>

        <p class="hero-subheading">
          {{ section.settings.subheading | default: 'Explore our portfolio of artisanal fragrances — from our commanding 50ml Signature Collection to versatile 10ml & 20ml Discovery editions.' }}
        </p>

        <div class="hero-cta-group">
          {%- if section.settings.cta_primary_label != blank -%}
            {%- assign primary_target = section.settings.cta_primary_url | default: section.settings.primary_collection.url -%}
            <a
              href="{{ primary_target | default: routes.all_products_collection_url | default: '/collections/all' }}"
              class="btn btn-primary btn-lg"
              id="HeroPrimaryAction"
            >
              <span>{{ section.settings.cta_primary_label }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.cta_secondary_label != blank -%}
            {%- assign secondary_target = section.settings.cta_secondary_url | default: section.settings.secondary_collection.url -%}
            {%- if secondary_target != blank -%}
              <a
                href="{{ secondary_target }}"
                class="btn btn-outline btn-lg"
                id="HeroSecondaryAction"
              >
                <span>{{ section.settings.cta_secondary_label }}</span>
              </a>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if section.settings.show_highlights -%}
          <div class="hero-highlights-row">
            <div class="hero-highlight-item">
              <span class="highlight-title">{{ section.settings.highlight_1_title | default: '3 Flagships' }}</span>
              <span class="highlight-desc">{{ section.settings.highlight_1_desc | default: 'The Signature 50ml' }}</span>
            </div>
            <div class="hero-highlight-divider"></div>
            <div class="hero-highlight-item">
              <span class="highlight-title">{{ section.settings.highlight_2_title | default: '6 Editions' }}</span>
              <span class="highlight-desc">{{ section.settings.highlight_2_desc | default: 'The Discovery 10ml & 20ml' }}</span>
            </div>
            <div class="hero-highlight-divider"></div>
            <div class="hero-highlight-item">
              <span class="highlight-title">{{ section.settings.highlight_3_title | default: 'Regional' }}</span>
              <span class="highlight-desc">{{ section.settings.highlight_3_desc | default: 'Kerala, Karnataka & UAE' }}</span>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Hero Visual Media Column {%- endcomment -%}
      <div class="hero-visual reveal reveal-delay-2">
        <div class="hero-media-wrapper">
          {%- if section.settings.hero_image != blank -%}
            <img
              src="{{ section.settings.hero_image | image_url: width: 1200 }}"
              alt="{{ section.settings.hero_image.alt | default: 'AD PERFUMES Flacon' | escape }}"
              class="hero-media-img"
              loading="eager"
              fetchpriority="high"
              width="1000"
              height="1150"
            >
          {%- else -%}
            <img
              src="{{ 'hero-perfume.jpg' | asset_url }}"
              alt="AD PERFUMES Luxury Fragrance"
              class="hero-media-img"
              loading="eager"
              fetchpriority="high"
              width="1000"
              height="1150"
            >
          {%- endif -%}

          {%- if section.settings.floating_badge_text != blank -%}
            <div class="hero-floating-glass-card">
              <span class="glass-icon">✦</span>
              <div class="glass-text-group">
                <span class="glass-title">{{ section.settings.floating_badge_text | default: 'Artisanal Perfume' }}</span>
                <span class="glass-sub">{{ section.settings.floating_badge_sub | default: 'Crafted by AD PERFUMES' }}</span>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "AD PERFUMES • HAUTE PARFUMERIE"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading Line 1",
      "default": "Distinctive Fragrances"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading Line 2 (Accent)",
      "default": "Crafted with Precision"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Explore our portfolio of artisanal fragrances — from our commanding 50ml Signature Collection to versatile 10ml & 20ml Discovery editions."
    },
    {
      "type": "header",
      "content": "Primary Call to Action"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary Button Label",
      "default": "Explore The Signature Collection"
    },
    {
      "type": "collection",
      "id": "primary_collection",
      "label": "Primary Collection Destination"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Custom URL Override (Optional)"
    },
    {
      "type": "header",
      "content": "Secondary Call to Action"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary Button Label",
      "default": "Discover Travel Formats"
    },
    {
      "type": "collection",
      "id": "secondary_collection",
      "label": "Secondary Collection Destination"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Custom URL Override (Optional)"
    },
    {
      "type": "header",
      "content": "Visual & Image"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "floating_badge_text",
      "label": "Floating Card Title",
      "default": "Artisanal Perfumery"
    },
    {
      "type": "text",
      "id": "floating_badge_sub",
      "label": "Floating Card Subtitle",
      "default": "Your Fragrance. Your Vision. Your Brand."
    },
    {
      "type": "header",
      "content": "Highlights Bar"
    },
    {
      "type": "checkbox",
      "id": "show_highlights",
      "label": "Show Highlights Below CTAs",
      "default": true
    },
    {
      "type": "text",
      "id": "highlight_1_title",
      "label": "Highlight 1 Title",
      "default": "3 Flagships"
    },
    {
      "type": "text",
      "id": "highlight_1_desc",
      "label": "Highlight 1 Description",
      "default": "The Signature 50ml"
    },
    {
      "type": "text",
      "id": "highlight_2_title",
      "label": "Highlight 2 Title",
      "default": "6 Editions"
    },
    {
      "type": "text",
      "id": "highlight_2_desc",
      "label": "Highlight 2 Description",
      "default": "The Discovery 10ml & 20ml"
    },
    {
      "type": "text",
      "id": "highlight_3_title",
      "label": "Highlight 3 Title",
      "default": "Regional"
    },
    {
      "type": "text",
      "id": "highlight_3_desc",
      "label": "Highlight 3 Description",
      "default": "Kerala, Karnataka & UAE"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
