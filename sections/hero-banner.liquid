<section class="hero" id="hero" aria-label="Hero banner">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="hero-particles" aria-hidden="true"></div>

  <div class="hero-content">

    {%- comment -%} Text Side {%- endcomment -%}
    <div class="hero-text">
      <p class="hero-eyebrow">
        {{ section.settings.eyebrow_text | default: 'New Arrival 2024' }}
      </p>

      <h1 class="hero-title">
        {%- if section.settings.heading_line1 != blank -%}
          {{ section.settings.heading_line1 }}<br>
        {%- else -%}
          The Art of<br>
        {%- endif -%}
        <em>
          {%- if section.settings.heading_line2 != blank -%}
            {{ section.settings.heading_line2 }}
          {%- else -%}
            Invisible Luxury
          {%- endif -%}
        </em>
      </h1>

      <p class="hero-description">
        {{ section.settings.subheading | default: 'Two masterpieces born from rare ingredients and a century of olfactory tradition. Each bottle holds a story that lingers long after you leave the room.' }}
      </p>

      <div class="hero-actions">
        <a
          href="{{ section.settings.cta_primary_url | default: '/collections/flagship' }}"
          class="btn btn-primary btn-lg"
          id="HeroPrimaryBtn"
        >
          {{ section.settings.cta_primary_label | default: 'Shop Flagships' }}
        </a>
        <a
          href="{{ section.settings.cta_secondary_url | default: '/collections/all' }}"
          class="btn btn-outline btn-lg"
          id="HeroSecondaryBtn"
        >
          {{ section.settings.cta_secondary_label | default: 'Explore Collection' }}
        </a>
      </div>

      <div class="hero-stats">
        <div class="hero-stat">
          <span class="hero-stat-number">{{ section.settings.stat_1_number | default: '24h' }}</span>
          <span class="hero-stat-label">{{ section.settings.stat_1_label | default: 'Longevity' }}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">{{ section.settings.stat_2_number | default: '100%' }}</span>
          <span class="hero-stat-label">{{ section.settings.stat_2_label | default: 'Natural Oils' }}</span>
        </div>
        <div class="hero-stat">
          <span class="hero-stat-number">{{ section.settings.stat_3_number | default: '50+' }}</span>
          <span class="hero-stat-label">{{ section.settings.stat_3_label | default: 'Rare Ingredients' }}</span>
        </div>
      </div>
    </div>

    {%- comment -%} Visual Side {%- endcomment -%}
    <div class="hero-visual">
      <div class="hero-image-wrapper">
        {%- if section.settings.hero_image != blank -%}
          <img
            src="{{ section.settings.hero_image | image_url: width: 900 }}"
            alt="{{ section.settings.hero_image.alt | default: 'Premium Perfume' | escape }}"
            class="hero-image"
            loading="eager"
            fetchpriority="high"
            width="900"
            height="1100"
          >
        {%- else -%}
          <div class="hero-image" style="
            aspect-ratio: 4/5;
            background: linear-gradient(145deg, #1a1410 0%, #2a1f0e 30%, #1a1410 70%, #0f0d0a 100%);
            display: flex;
            align-items: center;
            justify-content: center;
          ">
            <div style="text-align: center;">
              <div style="font-size: 100px; margin-bottom: 16px; filter: drop-shadow(0 0 40px rgba(201,168,76,0.4));">🌟</div>
              <div style="font-family: var(--font-display); font-size: var(--text-2xl); color: var(--color-gold); letter-spacing: 0.1em;">LUMIÈRE NOIR</div>
              <div style="font-size: var(--text-xs); color: var(--color-text-muted); letter-spacing: 0.3em; margin-top: 8px; text-transform: uppercase;">Eau de Parfum</div>
            </div>
          </div>
        {%- endif -%}

        {%- comment -%} Floating badge {%- endcomment -%}
        <div class="hero-image-badge">
          <div class="hero-image-badge-icon">⭐</div>
          <div class="hero-image-badge-text">
            <span class="hero-image-badge-title">{{ section.settings.badge_title | default: 'Bestseller 2024' }}</span>
            <span class="hero-image-badge-sub">{{ section.settings.badge_sub | default: '4.9 ★ 2.4k reviews' }}</span>
          </div>
        </div>
      </div>
    </div>

  </div>

  {%- comment -%} Scroll indicator {%- endcomment -%}
  <div class="hero-scroll-indicator" aria-hidden="true">
    <span class="hero-scroll-text">Scroll</span>
    <span class="hero-scroll-line"></span>
  </div>

</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "New Arrival 2024"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "The Art of"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (italic gold)",
      "default": "Invisible Luxury"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Two masterpieces born from rare ingredients and a century of olfactory tradition."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary CTA label",
      "default": "Shop Flagships"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary CTA URL"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary CTA label",
      "default": "Explore Collection"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary CTA URL"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 number",
      "default": "24h"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 label",
      "default": "Longevity"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 label",
      "default": "Natural Oils"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 number",
      "default": "50+"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 label",
      "default": "Rare Ingredients"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Floating badge title",
      "default": "Bestseller 2024"
    },
    {
      "type": "text",
      "id": "badge_sub",
      "label": "Floating badge subtitle",
      "default": "4.9 ★ 2.4k reviews"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
