<section class="hero" id="hero" aria-label="Hero banner">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-container">
    <div class="hero-content">

      {%- comment -%} Text Column {%- endcomment -%}
      <div class="hero-text reveal">
        <div class="hero-pill">
          <span class="hero-pill-dot"></span>
          <span>{{ section.settings.eyebrow_text | default: 'HAUTE PARFUMERIE • PARIS' }}</span>
        </div>

        <h1 class="hero-title">
          {%- if section.settings.heading_line1 != blank -%}
            {{ section.settings.heading_line1 }}
          {%- else -%}
            The Art of
          {%- endif -%}
          <span class="hero-title-accent">
            {%- if section.settings.heading_line2 != blank -%}
              {{ section.settings.heading_line2 }}
            {%- else -%}
              Invisible Luxury
            {%- endif -%}
          </span>
        </h1>

        <p class="hero-description">
          {{ section.settings.subheading | default: 'Crafted with the rarest French fragrance essences and aged to absolute perfection. Fragrances that evoke memories and command presence.' }}
        </p>

        <div class="hero-actions">
          <a
            href="{{ section.settings.cta_primary_url | default: routes.collections_url }}"
            class="btn btn-primary btn-lg"
            id="HeroPrimaryBtn"
          >
            {{ section.settings.cta_primary_label | default: 'Shop Best Sellers' }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="{{ section.settings.cta_secondary_url | default: '#category-spotlight' }}"
            class="btn btn-outline btn-lg"
            id="HeroSecondaryBtn"
          >
            {{ section.settings.cta_secondary_label | default: 'Explore Collections' }}
          </a>
        </div>

        <div class="hero-stats">
          <div class="hero-stat">
            <span class="hero-stat-number">{{ section.settings.stat_1_number | default: '24h+' }}</span>
            <span class="hero-stat-label">{{ section.settings.stat_1_label | default: 'Longevity' }}</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <span class="hero-stat-number">{{ section.settings.stat_2_number | default: '100%' }}</span>
            <span class="hero-stat-label">{{ section.settings.stat_2_label | default: 'Pure French Oils' }}</span>
          </div>
          <div class="hero-stat-divider"></div>
          <div class="hero-stat">
            <span class="hero-stat-number">{{ section.settings.stat_3_number | default: 'Cruelty' }}</span>
            <span class="hero-stat-label">{{ section.settings.stat_3_label | default: 'Free & Vegan' }}</span>
          </div>
        </div>
      </div>

      {%- comment -%} Visual Column {%- endcomment -%}
      <div class="hero-visual reveal reveal-delay-2">
        <div class="hero-image-wrapper">
          {%- if section.settings.hero_image != blank -%}
            <img
              src="{{ section.settings.hero_image | image_url: width: 1000 }}"
              alt="{{ section.settings.hero_image.alt | default: 'Artisanal Perfume Flacon' | escape }}"
              class="hero-image"
              loading="eager"
              fetchpriority="high"
              width="1000"
              height="1100"
            >
          {%- else -%}
            <img
              src="{{ 'hero-perfume.jpg' | asset_url }}"
              alt="Artisanal French Perfume"
              class="hero-image"
              loading="eager"
              fetchpriority="high"
              width="1000"
              height="1100"
            >
          {%- endif -%}

          {%- comment -%} Floating Glass Card {%- endcomment -%}
          <div class="hero-floating-card">
            <div class="hero-stars">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
            <div class="hero-floating-title">{{ section.settings.badge_title | default: 'Rated 4.9/5 by 12,000+ Connoisseurs' }}</div>
            <div class="hero-floating-sub">{{ section.settings.badge_sub | default: '“Best sillage and longevity I have ever worn.”' }}</div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow text",
      "default": "HAUTE PARFUMERIE • PARIS"
    },
    {
      "type": "text",
      "id": "heading_line1",
      "label": "Heading line 1",
      "default": "The Art of"
    },
    {
      "type": "text",
      "id": "heading_line2",
      "label": "Heading line 2 (accent font)",
      "default": "Invisible Luxury"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Crafted with the rarest French fragrance essences and aged to absolute perfection. Fragrances that evoke memories and command presence."
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Primary button text",
      "default": "Shop Best Sellers"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "cta_secondary_label",
      "label": "Secondary button text",
      "default": "Explore Collections"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "header",
      "content": "Key Metrics"
    },
    {
      "type": "text",
      "id": "stat_1_number",
      "label": "Stat 1 Number",
      "default": "24h+"
    },
    {
      "type": "text",
      "id": "stat_1_label",
      "label": "Stat 1 Label",
      "default": "Longevity"
    },
    {
      "type": "text",
      "id": "stat_2_number",
      "label": "Stat 2 Number",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "stat_2_label",
      "label": "Stat 2 Label",
      "default": "Pure French Oils"
    },
    {
      "type": "text",
      "id": "stat_3_number",
      "label": "Stat 3 Number",
      "default": "Cruelty"
    },
    {
      "type": "text",
      "id": "stat_3_label",
      "label": "Stat 3 Label",
      "default": "Free & Vegan"
    },
    {
      "type": "header",
      "content": "Floating Review Badge"
    },
    {
      "type": "text",
      "id": "badge_title",
      "label": "Badge Title",
      "default": "Rated 4.9/5 by 12,000+ Connoisseurs"
    },
    {
      "type": "text",
      "id": "badge_sub",
      "label": "Badge Quote",
      "default": "“Best sillage and longevity I have ever worn.”"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
