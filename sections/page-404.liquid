    </p>
    <div style="display: flex; gap: var(--space-4); flex-wrap: wrap; justify-content: center; margin-top: var(--space-4);">
      <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg">Go Home</a>
      <a href="{{ routes.collections_url }}/all" class="btn btn-outline btn-lg">Shop Collection</a>
    </div>
  </div>
</div>

