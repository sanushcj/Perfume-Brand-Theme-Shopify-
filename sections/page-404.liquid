<div class="page-404 section-padding-lg">
  <div class="container text-center">
    <div class="page-404-content">
      <div class="page-404-number" aria-hidden="true">404</div>
      <p class="section-eyebrow justify-center">Fragrance Boutique</p>
      <h1 class="section-title">Page Not Found</h1>
      <p class="section-subtitle max-w-prose">
        The destination you are looking for does not exist or may have been relocated. Allow us to guide you back to our fragrance portfolio.
      </p>
      <div class="page-404-actions">
        <a href="{{ routes.root_url }}" class="btn btn-primary btn-lg">Return to Boutique</a>
        <a href="{{ routes.all_products_collection_url | default: '/collections/all' }}" class="btn btn-outline btn-lg">Browse All Fragrances</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "settings": []
}
{% endschema %}
