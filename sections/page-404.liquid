<div class="page-404">
  <div class="page-404-content">
    <div class="page-404-number" aria-hidden="true">404</div>
    <p class="section-eyebrow" style="justify-content: center;">Lost in the Mist</p>
    <h1 class="section-title">This Page Has Evaporated</h1>
    <p style="font-size: var(--text-lg); color: var(--color-text-muted); max-width: 400px; text-align: center; line-height: 1.7; font-weight: var(--fw-light);">
