<section class="brand-story section-padding-lg" id="brand-story-{{ section.id }}" aria-label="Brand Story">
  <div class="container">
    <div class="brand-story-layout">

      {%- comment -%} Visual Column {%- endcomment -%}
      <div class="brand-story-visual reveal">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 800 }}"
            alt="{{ section.settings.image.alt | default: 'AD PERFUMES Philosophy' | escape }}"
            class="brand-story-image"
            loading="lazy"
            width="800"
            height="1000"
          >
        {%- else -%}
          <img
            src="{{ 'hero-perfume.jpg' | asset_url }}"
            alt="AD PERFUMES Craftsmanship"
            class="brand-story-image"
            loading="lazy"
            width="800"
            height="1000"
          >
        {%- endif -%}
        <div class="brand-story-accent" aria-hidden="true"></div>
      </div>

      {%- comment -%} Content Column {%- endcomment -%}
      <div class="brand-story-content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-eyebrow reveal">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        <h2 class="section-title reveal reveal-delay-1">{{ section.settings.title | default: 'Distinctive Fragrances, Enduring Character' }}</h2>

        <div class="reveal reveal-delay-2">
          {%- if section.settings.text != blank -%}
            <div class="brand-story-text">{{ section.settings.text }}</div>
          {%- else -%}
            <p class="brand-story-text">
              At <strong>AD PERFUMES</strong>, we believe fragrance is the ultimate invisible signature. From rich, smoky woods and warm saffron to crisp frozen bergamot and decadent caramelized ambers, every creation is composed with care and sophistication.
            </p>
            <p class="brand-story-text" style="margin-top: var(--space-4);">
              Whether discovering your personal scent identity through our 50ml Flagship collection or selecting everyday versatility from our 10ml & 20ml Discovery line, we deliver quality, elegance, and memorable fragrance experiences across Kerala, Karnataka, and the UAE.
            </p>
          {%- endif -%}
        </div>

        <div class="brand-pillars reveal reveal-delay-3">
          {%- for block in section.blocks -%}
            {%- if block.type == 'pillar' -%}
              <div class="brand-pillar" {{ block.shopify_attributes }}>
                <div class="brand-pillar-icon">{{ block.settings.icon | default: '✦' }}</div>
                <div class="brand-pillar-title">{{ block.settings.title }}</div>
                <div class="brand-pillar-text">{{ block.settings.text }}</div>
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="brand-pillar">
              <div class="brand-pillar-icon">🌿</div>
              <div class="brand-pillar-title">Distinctive Scents</div>
              <div class="brand-pillar-text">Curated note profiles tailored for depth, character, and sophistication.</div>
            </div>
            <div class="brand-pillar">
              <div class="brand-pillar-icon">🧴</div>
              <div class="brand-pillar-title">50ml & Travel Sizes</div>
              <div class="brand-pillar-text">Signature 50ml flacons alongside convenient 10ml & 20ml pocket editions.</div>
            </div>
            <div class="brand-pillar">
              <div class="brand-pillar-icon">📍</div>
              <div class="brand-pillar-title">Regional Dispatch</div>
              <div class="brand-pillar-text">Dedicated customer care serving clients across Kerala, Karnataka & the UAE.</div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
          <div class="reveal reveal-delay-4" style="margin-top: var(--space-6);">
            <a href="{{ section.settings.cta_url }}" class="btn btn-outline">
              {{ section.settings.cta_label }}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "The AD PERFUMES Vision"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Heading",
      "default": "Distinctive Fragrances, Enduring Character"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Story Narrative"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Optional Button Label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Optional Button Destination"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Feature Pillar",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji)",
          "default": "✦"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pillar Title",
          "default": "Distinctive Scents"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Pillar Description",
          "default": "Curated note profiles tailored for depth, character, and sophistication."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
